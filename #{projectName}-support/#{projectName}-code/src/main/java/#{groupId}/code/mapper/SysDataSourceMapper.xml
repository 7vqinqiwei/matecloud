<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="#{groupId}.code.mapper.SysDataSourceMapper">

    <resultMap id="mapperNodeResultMap" type="#{groupId}.core.common.vo.BaseListVO">
        <id column="id" property="key"/>
        <result column="name" property="title"/>
    </resultMap>

    <select id="optionList" resultMap="mapperNodeResultMap">
        select id, name
        from #{projectName}_sys_data_source
        where is_deleted = 0
    </select>
</mapper>
